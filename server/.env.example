# Local Docker Compose database ONLY. Replace every blank with independent random secrets.
DB_URL=jdbc:mysql://127.0.0.1:3307/communibuy?allowPublicKeyRetrieval=true&useSSL=false
DB_USER=communibuy
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Base64 of >=32 cryptographically random bytes; never commit .env.
JWT_SECRET=
PAYMENT_TIMEOUT_SECONDS=900
JWT_TTL_SECONDS=3600
# One bounded revocation cleanup batch at startup, then each delay (milliseconds).
REVOCATION_CLEANUP_ENABLED=true
REVOCATION_CLEANUP_DELAY_MS=60000
REVOCATION_CLEANUP_BATCH_SIZE=500
# Explicit local simulator only; disabled by default and forbidden by the deploy profile.
PAYMENT_MODE=simulator
PAYMENT_SIM_SECRET=
PAYMENT_MERCHANT=communibuy-demo
APP_PROFILES=local
APP_VERSION=local
CORS_ALLOWED_ORIGINS=
